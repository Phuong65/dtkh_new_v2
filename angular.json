{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "lcms_v2": {
            "projectType": "application",
            "schematics": {},
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "dist/lcms_v2",
                        "index": "src/index.html",
                        "polyfills": ["zone.js"],
                        "tsConfig": "tsconfig.app.json",
                        "assets": ["src/favicon.ico", "src/assets"],
                        "styles": [
                            "node_modules/quill/dist/quill.core.css",
                            "node_modules/quill/dist/quill.snow.css",
                            "src/custom-theme.scss",
                            "node_modules/viewerjs/dist/viewer.css",
                            "node_modules/plyr/dist/plyr.css",
                            "src/styles.css",
                            "src/assets/css/bootstrap.min.css",
                            "src/assets/css/gradient-bg.css",
                            "src/assets/css/uicon.css",
                            "src/assets/css/uil-icon.css",
                            "src/assets/css/font-awesome.min.css",
                            "src/assets/css/fontawesomev6.min.css",
                            "node_modules/primeng/resources/themes/lara-light-blue/theme.css",
                            "node_modules/primeng/resources/primeng.min.css",
                            "node_modules/primeicons/primeicons.css",
                            "src/assets/css/admin-dashboard.css",
                            "src/assets/css/base.css",
                            "src/assets/css/animation-loading.css",
                            "src/assets/css/style.css",
                            "src/assets/css/flickity.min.css",
                            "node_modules/latex.js/dist/css/katex.css",
                            "src/assets/css/ngan-hang-cau-hoi.css",
                            "src/assets/css/secondary.css"
                        ],
                        "scripts": [
                            "node_modules/quill/dist/quill.js",
                            "node_modules/apexcharts/dist/apexcharts.min.js",
                            "node_modules/chart.js/dist/chart.umd.js",
                            "src/assets/js/add-toolbar.js",
                            "src/assets/js/latex-toolbar.min.js"
                        ],
                        "stylePreprocessorOptions": {
                            "includePaths": ["."]
                        },
                        "allowedCommonJsDependencies": [
                            "quill", "crypto-js", "pdfjs-dist/web/pdf_viewer", "pdfjs-dist/build/pdf",
                            "viewerjs", "apexcharts", "plyr", "file-saver", "mic-recorder-to-mp3",
                            "mammoth/mammoth.browser.js", "exceljs", "html-docx-js-typescript", "jszip",
                            "mammoth-plus", "mathml-to-latex"
                        ]
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {"type": "initial", "maximumWarning": "5mb", "maximumError": "5mb"},
                                {"type": "anyComponentStyle", "maximumWarning": "15mb", "maximumError": "15mb"}
                            ],
                            "fileReplacements": [{"replace": "src/environments/environment.ts", "with": "src/environments/environment.prod.ts"}],
                            "outputHashing": "all",
                            "optimization": true,
                            "aot": true
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "namedChunks": true
                        },
                        "development-lowram": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": false,
                            "namedChunks": false
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {"buildTarget": "lcms_v2:build:production"},
                        "development": {
                            "buildTarget": "lcms_v2:build:development",
                            "sslKey": "localhost.key",
                            "sslCert": "localhost.crt"
                        },
                        "development-lowram": {"buildTarget": "lcms_v2:build:development-lowram"}
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "@angular/build:extract-i18n",
                    "options": {"buildTarget": "lcms_v2:build"}
                },
                "test": {
                    "builder": "@angular/build:karma",
                    "options": {
                        "polyfills": ["zone.js", "zone.js/testing"],
                        "tsConfig": "tsconfig.spec.json",
                        "assets": ["src/favicon.ico", "src/assets"],
                        "styles": ["src/styles.css"],
                        "scripts": []
                    }
                }
            }
        }
    },
    "cli": {"analytics": false}
}
